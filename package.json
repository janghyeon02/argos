{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:env": "node scripts/check-env.mts",
    "check:db": "node --env-file-if-exists=.env scripts/check-db.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check:ai": "tsx --env-file-if-exists=.env scripts/check-ai.ts",
    "check:sources": "tsx scripts/check-sources.ts",
    "collect": "tsx --env-file-if-exists=.env scripts/collect.ts",
    "enrich": "tsx --env-file-if-exists=.env scripts/enrich.ts",
    "cluster": "tsx --env-file-if-exists=.env scripts/cluster.ts",
    "score": "tsx --env-file-if-exists=.env scripts/score.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "openai": "^7.42.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
